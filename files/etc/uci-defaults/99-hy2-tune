#!/bin/sh
# 99-hy2-tune — K3 hy2 系统调优：首次开机执行一次后自删除
# 构建时放入: <固件仓库>/files/etc/uci-defaults/99-hy2-tune (chmod +x)
# 作用：把 governor + RPS 逻辑幂等地追加进 /etc/rc.local（每开机生效），
#       避免直接覆盖固件自带的 rc.local
# 注意：sysctl 类条目请走 files/etc/sysctl.d/99-hy2.conf，本脚本只处理
#       sysctl 覆盖不到的项（governor、RPS、中断亲和）

MARK="# --- hy2-tune: AP8220 governor+RPS (99-hy2-tune) ---"

# 确保 /etc/rc.local 存在
if [ ! -f /etc/rc.local ]; then
	cat > /etc/rc.local <<'RCEOF'
#!/bin/sh
exit 0
RCEOF
	chmod +x /etc/rc.local
fi

if ! grep -q "hy2-tune: AP8220 governor+RPS" /etc/rc.local 2>/dev/null; then
	# 去掉 rc.local 末尾的 exit 0，追加后再补回
	sed -i '/^exit 0$/d' /etc/rc.local
	cat >> /etc/rc.local <<'EOF'
# --- hy2-tune: AP8220 governor+RPS (99-hy2-tune) ---
# CPU governor: bcm53xx 通常没有 cpufreq（定频），有则锁 performance
# hy2 是 CPU 密集型实时负载，ondemand 爬坡延迟会引入抖动；K3 插电不计功耗
for p in /sys/devices/system/cpu/cpufreq/policy*; do
	[ -w "$p/scaling_governor" ] && echo performance > "$p/scaling_governor" 2>/dev/null
done
# RPS: 根据 CPU 数量动态设置 mask（双核=3，四核=f）
# 有几个 rx 队列就分几个，不挑接口
CPUS=$(nproc 2>/dev/null || echo 2)
if [ "$CPUS" -ge 4 ]; then
	RPS_MASK=f
else
	RPS_MASK=3
fi
for q in /sys/class/net/*/queues/rx-*/rps_cpus; do
	echo $RPS_MASK > "$q" 2>/dev/null
done
# --- hy2-tune end ---
EOF
	echo "exit 0" >> /etc/rc.local
fi

# 本次开机也立即生效一次（不等下次重启）
for p in /sys/devices/system/cpu/cpufreq/policy*; do
	[ -w "$p/scaling_governor" ] && echo performance > "$p/scaling_governor" 2>/dev/null
done
CPUS=$(nproc 2>/dev/null || echo 2)
if [ "$CPUS" -ge 4 ]; then
	RPS_MASK=f
else
	RPS_MASK=3
fi
for q in /sys/class/net/*/queues/rx-*/rps_cpus; do
	echo $RPS_MASK > "$q" 2>/dev/null
done

exit 0
